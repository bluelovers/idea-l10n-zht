{
  "name": "idea-l10n-zht",
  "version": "1.0.0",
  "description": "Jetbrains IntelliJ Chinese (Traditional) Language Pack / 繁體中文語言包",
  "keywords": [
    "create-by-yarn-tool"
  ],
  "homepage": "https://github.com/bluelovers/idea-l10n-zht#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/idea-l10n-zht/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/idea-l10n-zht.git"
  },
  "license": "ISC",
  "author": "bluelovers",
  "main": "index.js",
  "scripts": {
    "test": "jest --passWithNoTests -u",
    "test:jest": "jest --passWithNoTests",
    "test:jest:snapshot": "pnpm run test:jest -- -u",
    "test:snapshot": "pnpm run test -- -u",
    "test:tsd": "ynpx tsd",
    "test:tsdx": "ynpx @bluelovers/tsdx test --passWithNoTests",
    "posttest": "pnpm run build:sort",
    "prebuild": "tsx scripts/update-meta.ts",
    "build": "tsx scripts/plugin-build-install-file.ts",
    "build:commit": "tsx ./scripts/git/build-commit.ts",
    "build:dts": "ynpx dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner & echo build:dts",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:microbundle": "ynpx microbundle --target node",
    "build:sort": "tsx scripts/sort-static-files.ts",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node --name index",
    "postbuild": "pnpm run test && tsx ./scripts/jetbrains/create-jetbrains-update-plugins-xml.ts",
    "ci:test": "pnpm run test",
    "ci:install": "pnpm install --frozen-lockfile && pnpm add tsx",
    "ci:install:old": "pnpm install --frozen-lockfile && pnpm add -w typescript@6.0.0-dev.20260204 jest ts-jest@next ts-node@10.0 ynpx lerna@6 yarn-tool @bluelovers/jest-config tsx",
    "ci:build": "pnpm run plugin:build && pnpm run build:commit",
    "ci:build:sub": "pnpm run plugin:build:core && pnpm run build:commit && pnpm run ci:postpublish",
    "ci:postpublish": "tsx scripts/ci-postpublish.ts && pnpm run postpublish:git:tag && echo ci:postpublish",
    "_ci:postpublish": "pnpm run postpublish:changelog && pnpm run postpublish:git:commit && pnpm run postpublish:git:tag & echo ci:postpublish",
    "ci:git:config": "git config --local core.autocrlf false && git config --local core.ignorecase false && git config --local include.path ../.gitconfig && git config --local core.autocrlf false && git config --local core.ignorecase false",
    "ci:git:fetch:remote:tag": "git fetch --tag -f",
    "npm:publish": "npm publish",
    "npm:publish:bump": "pnpm run version:bump && npm publish",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "version:bump": "yarn-tool version",
    "postversion": "echo postversion",
    "prepublish": "echo prepublish",
    "prepare": "echo prepare",
    "prepublishOnly": "pnpm run preversion",
    "prepublishOnly:check-bin": "ynpx --quiet @yarn-tool/check-pkg-bin",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "prepack": "echo prepack",
    "pack": "echo pack",
    "postpack": "echo postpack",
    "publish": "echo publish",
    "postpublish": "pnpm run postpublish:changelog && pnpm run postpublish:git:commit && pnpm run postpublish:git:tag -- --force-git-tag && pnpm run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md",
    "postpublish:git:commit": "git commit -m \"build(changelog): update CHANGELOG\" ./CHANGELOG.md & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "tsx scripts/update-git-tag.ts",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "plugin:build": "pnpm run test && pnpm run plugin:build:core",
    "plugin:build:core": "pnpm run plugin:handle-source && pnpm run build",
    "plugin:handle-source": "tsx scripts/plugin-handle-source.ts",
    "plugin:series:build": "tsx ./bin/build-series",
    "plugin:series:download": "tsx ./bin/download-series",
    "plugin:jar:download": "tsx ./scripts/download-original-plugin.ts",
    "plugin:zht": "tsx scripts/to-zht.ts && tsx scripts/properties-replace.ts",
    "sort-package-json": "yarn-tool sort",
    "tsc:default": "tsc -p tsconfig.json",
    "tsc:esm": "tsc -p tsconfig.esm.json",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  },
  "dependencies": {
    "@bluelovers/fast-glob": "^3.0.4",
    "@bluelovers/string-natural-compare": "^2.0.15",
    "@git-lazy/branch": "^2.0.3",
    "@git-lazy/spawn": "^2.0.3",
    "@git-lazy/tag": "^2.0.3",
    "@git-lazy/tag-list": "^2.0.3",
    "@lazy-cjk/zh-convert": "^1.0.58",
    "@lazy-node/semver-part": "^1.0.27",
    "@lazy-node/semver-simple-parse": "^4.0.8",
    "@novel-segment/assert": "^1.0.13",
    "@novel-segment/loaders": "^1.0.55",
    "@novel-segment/pretty-diff": "^1.0.28",
    "@novel-segment/sort-dict-table": "^1.0.31",
    "@novel-segment/sort-synonym": "^1.0.27",
    "@novel-segment/stringify": "^1.0.18",
    "@novel-segment/types": "^1.0.14",
    "@novel-segment/util": "^1.0.80",
    "@novel-segment/util-compare": "^1.0.28",
    "@ts-type/is-array": "^1.0.15",
    "@yarn-tool/find-root": "^2.0.25",
    "ansi-colors": "^4.1.3",
    "array-chunk-split": "^2.0.17",
    "array-hyper-unique": "^2.1.8",
    "bluebird": "^3.7.2",
    "cache-path": "^4.0.12",
    "cjk-conv": "^1.2.153",
    "cli-progress": "^3.12.0",
    "crlf-normalize": "^1.0.26",
    "cross-fetch": "^4.1.0",
    "debug-color2": "^1.3.2",
    "dot-properties-loader": "^1.0.5",
    "dot-properties2": "^1.0.4",
    "enquirer": "^2.4.1",
    "escape-string-regexp": "<5 >=4.0.0",
    "fs-extra": "^11.4.0",
    "is-interactive": "<2 >=1",
    "jszip": "^3.10.2",
    "jszip-fixed-date": "^1.0.7",
    "lazy-url": "^2.0.5",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.2",
    "micromatch": "^4.0.8",
    "moment": "^2.30.1",
    "novel-segment": "^2.7.123",
    "novel-segment-cli": "^1.1.141",
    "progress-estimator": "^0.3.1",
    "regexp-cjk": "^3.3.120",
    "regexp-cjk-with-plugin-enabled": "^1.0.26",
    "regexp-helper": "^1.0.46",
    "semver": "^7.8.5",
    "sort-object-keys2": "^3.0.8",
    "ts-type": "^3.0.13",
    "tslib": "^2.8.1",
    "upath2": "^3.1.25",
    "xmlbuilder2": "^4.0.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@bluelovers/jest-config": "^1.1.13",
    "@bluelovers/tsconfig": "^2.0.3",
    "@git-lazy/debug": "^2.0.3",
    "@jest/types": "^30.5.1",
    "@types/bluebird": "^3.5.42",
    "@types/cli-progress": "^3.11.6",
    "@types/conventional-changelog": "^6.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/markdown-it": "^14.2.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.5.1",
    "@types/node-fetch": "<3 >=2.5.12",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "@yarn-tool/changelog": "^3.0.14",
    "@yarn-tool/require-resolve": "^4.0.9",
    "@yarn-tool/ws-find-up-paths": "^1.0.22",
    "git-diff-from": "^2.0.3",
    "gitlog2": "^6.0.3",
    "jest": "<30 >=29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "6.0.3"
  }
}
